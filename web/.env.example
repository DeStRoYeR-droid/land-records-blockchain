# Copy to .env.local to override. ./startup.sh sets both for you.

# Where the LandChain gateway (python -m gateway) listens. Only the Next.js
# server talks to it; browsers go through /gw on this site.
LANDCHAIN_GATEWAY_URL=http://127.0.0.1:13900

# The public address of this site, used for canonical URLs, the sitemap and
# Open Graph tags. Set it to your real domain when you deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
