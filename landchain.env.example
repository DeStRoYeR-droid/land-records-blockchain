# Copy to landchain.env (same folder as landchain.sh) and edit. landchain.env is git-ignored
# and is read by every LandChain process; real environment variables win over this file.
#
# The AI validator talks to oMLX (https://github.com/jundot/omlx), which serves MLX models on
# Apple Silicon through an OpenAI-compatible API.

# Where oMLX listens (its default port is 8000).
OMLX_BASE_URL=http://127.0.0.1:8000/v1

# The API key you created in oMLX (Admin > Auth). Never commit it, never paste it into a ticket.
# Leave empty if your oMLX has no key.
OMLX_API_KEY=

# Model id exactly as GET /v1/models lists it (e.g. Qwen2.5-3B-Instruct-4bit).
# Empty = the first model oMLX lists.
OMLX_MODEL=Qwen2.5-3B-Instruct-4bit

# --- optional ---------------------------------------------------------------
# auto: use oMLX when it answers, else the template writer.  omlx: insist.  template: never call a model.
#LANDCHAIN_EXPLAINER=auto
# A second, advisory opinion from the model on each explanation: auto | on | off
#LANDCHAIN_JUDGE=auto
# An explanation scoring below this is redrafted once, then replaced by the template.
#LANDCHAIN_FAITHFULNESS_MIN=0.8
#LANDCHAIN_DRAFT_ATTEMPTS=2
#OMLX_TEMPERATURE=0.2
# The investigating agent: tool calls and model turns per file, and how tool calls travel
# (auto: OpenAI `tools` as oMLX parses them for Qwen; falls back to <tool_call> text if refused).
#LANDCHAIN_INVESTIGATE=auto
#LANDCHAIN_AGENT_MAX_CALLS=5
#LANDCHAIN_AGENT_MAX_TURNS=7
#LANDCHAIN_AGENT_TOOLS=auto
# The model reviews its own rejected drafts and chooses redraft or template: auto | off
#LANDCHAIN_REFLECT=auto
# Dev server only: the web app's own address, used for canonical URLs and share cards.
#NEXT_PUBLIC_SITE_URL=http://localhost:3000
